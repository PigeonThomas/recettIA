# Ce fichier contient les valeurs par défaut des variables d'environnement.
# Il est versionné dans Git : il ne doit donc JAMAIS contenir de vrai secret.
# Pour vos secrets locaux (comme la clé de l'API Claude), copiez ce fichier
# en ".env.local" (ignoré par Git) et remplacez les valeurs.

###> symfony/framework-bundle ###
APP_ENV=dev
APP_DEBUG=1
APP_SECRET=efe20bd197006e69a3da290363ae8419
###< symfony/framework-bundle ###

###> recettia/claude-api ###
# Clé d'API "Claude" (Anthropic) utilisée pour générer les recettes.
# Créez un fichier .env.local avec votre vraie clé, par exemple :
#   ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
ANTHROPIC_API_KEY=
# Modèle Claude à utiliser pour générer les recettes.
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
###< recettia/claude-api ###
